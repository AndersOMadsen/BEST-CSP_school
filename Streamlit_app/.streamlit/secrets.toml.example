# Copy this file to .streamlit/secrets.toml and fill in real values.
# NEVER commit secrets.toml to version control.

# Anthropic API key — required for the checkCIF Tutor (tab 5).
# The rest of the app (COD search tabs, curated downloads) works without it.
ANTHROPIC_API_KEY = "sk-ant-..."

# Instructor reveal gate — controls whether teaching notes can be unlocked.
# Set REVEAL_ENABLED = true and choose a passphrase before the course day.
REVEAL_ENABLED = false
REVEAL_PASSPHRASE = "choose-a-passphrase"

# Blind-mode default — controls what students see before opening any expander.
# true  (recommended): only the title and files are shown; pathology_category
#        is hidden inside a "Need a hint?" expander the student opens voluntarily.
# false: pathology_category is shown inline; no hint expander is displayed.
# To flip modes between courses, change this value and restart the app.
BLIND_MODE_DEFAULT = true
